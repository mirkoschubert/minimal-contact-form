{
  "name": "mcf-admin-app",
  "version": "1.0.0",
  "description": "React admin interface for Minimal Contact Form",
  "private": true,
  "scripts": {
    "start": "wp-scripts start",
    "build": "wp-scripts build && mv ../assets/admin/*.css ../assets/admin/css/ 2>/dev/null || true",
    "lint:js": "wp-scripts lint-js",
    "format": "wp-scripts format",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^7.0.0",
    "@wordpress/components": "^30.9.0",
    "@wordpress/element": "^6.0.0",
    "@wordpress/i18n": "^6.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@wordpress/scripts": "^31.1.0",
    "typescript": "^5.3.0"
  }
}
